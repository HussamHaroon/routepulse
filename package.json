{
  "name": "routepulse",
  "version": "0.1.0",
  "private": true,
  "description": "Live public-transport tracking platform — API + GPS simulator",
  "workspaces": [
    "api",
    "simulator"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node api/server.js",
    "api": "node api/server.js",
    "sim": "node simulator/sim.js",
    "sim:slow": "node simulator/sim.js --speed=16",
    "sim:bus": "node simulator/sim.js --bus=B-07",
    "dev": "concurrently -k -n api,sim -c blue,green \"node api/server.js\" \"node simulator/sim.js\"",
    "test": "node --test tests/api.test.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
