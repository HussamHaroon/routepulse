# ================================================================
# Routepulse environment template
# ----------------------------------------------------------------
# .env is git-ignored (see .gitignore) — NEVER commit real keys.
# Copy this file to .env and fill in the values:
#
#     cp .env.example .env
#
# Restart the API after editing .env so changes take effect.
# ================================================================

# --- Image providers (optional) ---------------------------------
# Only needed for stock imagery. Map tiles (CARTO basemaps) ship with
# a bundled demo key; override with your own if rate-limited.
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=

# --- Frontend (Vite — baked into the build) ----------------------
# CARTO Basemaps key (https://carto.com/basemaps/). Restrict by
# referrer in the CARTO dashboard for production use.
VITE_CARTO_KEY=

# --- API server -------------------------------------------------
# Port the Express API + WebSocket listen on (default 8787).
PORT=8787
